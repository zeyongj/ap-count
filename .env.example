# Managed Clerk integration (publishable key is safe for the browser).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Server-side allowlist: only the verified primary email can edit shared rules.
AP_COUNT_ADMIN_EMAIL=

# Managed private Vercel Blob store. Connect separate production/development stores.
# The SDK supports either managed BLOB_READ_WRITE_TOKEN or OIDC + BLOB_STORE_ID.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
